# Auto-detect text files and perform LF normalization
* text=auto

# Force LF line endings for source and config files
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Force CRLF line endings for Windows batch files
*.bat text eol=crlf

# Treat all binaries explicitly as binary to prevent line ending or encoding corruption
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.gif binary
*.keystore binary